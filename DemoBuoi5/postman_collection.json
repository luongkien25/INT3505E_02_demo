{
  "info": {
    "_postman_id": "b3d7c8b6-0000-4000-8000-000000000000",
    "name": "DemoBuoi5 - Shop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection to test the demo shop API (import into Postman). Use collection variable 'base_url' and 'access_token'."
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:5000" },
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "Index",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      }
    },
    {
      "name": "Login (admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.access_token) { pm.collectionVariables.set('access_token', json.access_token); }",
              "pm.test('Login OK', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List Products (page)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{base_url}}/products?page=1&per_page=10"
      }
    },
    {
      "name": "List Products (offset)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{base_url}}/products?offset=0&limit=10"
      }
    },
    {
      "name": "Create Product (admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"name\": \"Sample Product\", \"price\": 19.99 }" },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "Create Customer (admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"name\": \"Alice\", \"email\": \"alice@example.com\", \"password\": \"Secret123\" }" },
        "url": "{{base_url}}/customers"
      }
    },
    {
      "name": "List Customers",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{access_token}}" } ],
        "url": "{{base_url}}/customers"
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"customer_id\": 1, \"product_id\": 1, \"order_date\": \"2025-10-24T12:00:00\" }" },
        "url": "{{base_url}}/orders"
      }
    },
    {
      "name": "List Orders",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{access_token}}" } ],
        "url": "{{base_url}}/orders?page=1&per_page=10"
      }
    },
    {
      "name": "List Orders by Customer (id=1)",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{access_token}}" } ],
        "url": "{{base_url}}/customers/1/orders?page=1&per_page=10"
      }
    }
  ]
}
